{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pericles Desktop Widget",
  "version": "1.0.0",
  "identifier": "com.periclesdev.desktopwidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pericles Desktop Widget",
        "width": 790,
        "height": 204,
        "minWidth": 340,
        "minHeight": 190,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost https://geocoding-api.open-meteo.com https://api.open-meteo.com https://api.bigdatacloud.net https://ipwho.is"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "Relógio, alarmes, lembretes e previsão do tempo",
    "longDescription": "Widget de desktop personalizável para Windows.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
